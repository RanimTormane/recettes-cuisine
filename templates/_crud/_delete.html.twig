{# Bouton de suppression sécurisé (POST + jeton CSRF). Variables : route, id #}
<form method="post" action="{{ path(route, {id: id}) }}" class="d-inline"
      onsubmit="return confirm('Confirmer la suppression ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ id) }}">
    <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Supprimer"><i class="bi bi-trash"></i></button>
</form>
