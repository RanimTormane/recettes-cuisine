{% extends 'base.html.twig' %}

{% block title %}{{ recipe.name }}{% endblock %}

{% block body %}
<div class="container py-4">
    <a href="{{ path('app_recipe_index') }}" class="text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Toutes les recettes</a>

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mt-3 mb-4">
        <div>
            <span class="badge badge-cat">{{ recipe.category.name }}</span>
            <h1 class="mt-2 mb-2">{{ recipe.name }}</h1>
            <p class="lead text-muted mb-0">{{ recipe.description }}</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_recipe_edit', {id: recipe.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil me-1"></i>Modifier</a>
            {% include '_crud/_delete.html.twig' with {route: 'app_recipe_delete', id: recipe.id} %}
        </div>
    </div>

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header fw-bold">Ingrédients</div>
                <ul class="list-group list-group-flush">
                    {% for ingredient in recipe.ingredients %}
                        <li class="list-group-item">{{ ingredient.name }}</li>
                    {% else %}
                        <li class="list-group-item text-muted">Aucun ingrédient.</li>
                    {% endfor %}
                </ul>
            </div>
        </div>
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-header fw-bold">Préparation</div>
                {# Une étape par ligne dans le champ "steps" #}
                <ol class="list-group list-group-flush list-group-numbered">
                    {% for step in recipe.steps|split("\n") %}
                        {% if step|trim %}
                            <li class="list-group-item">{{ step|trim }}</li>
                        {% endif %}
                    {% endfor %}
                </ol>
            </div>
        </div>
    </div>
</div>
{% endblock %}
