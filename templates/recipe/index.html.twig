{% extends 'base.html.twig' %}

{% block title %}Recettes{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h1 class="h3 m-0">Recettes</h1>
        <a href="{{ path('app_recipe_new') }}" class="btn btn-brand"><i class="bi bi-plus-lg me-2"></i>Ajouter une recette</a>
    </div>

    {# Recherche par nom et filtre par catégorie (envoyés dans l’URL : ?q=...&category=...) #}
    <form method="get" action="{{ path('app_recipe_index') }}" class="row g-2 mb-4">
        <div class="col-md-5">
            <input type="search" name="q" value="{{ q|default('') }}" class="form-control" placeholder="Rechercher par nom" aria-label="Rechercher par nom">
        </div>
        <div class="col-md-4">
            <select name="category" class="form-select" aria-label="Catégorie">
                <option value="">Toutes les catégories</option>
                {% for category in categories %}
                    <option value="{{ category.id }}" {{ category_id|default(0) == category.id ? 'selected' }}>{{ category.name }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-brand flex-grow-1" type="submit"><i class="bi bi-search me-2"></i>Filtrer</button>
            <a href="{{ path('app_recipe_index') }}" class="btn btn-outline-secondary" title="Réinitialiser" aria-label="Réinitialiser"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>

    <div class="row g-4">
        {% for recipe in recipes %}
            <div class="col-md-6 col-lg-4">
                <article class="recipe-card h-100">
                    <div class="recipe-thumb"><i class="bi bi-egg-fried"></i></div>
                    <div class="p-3">
                        <span class="badge badge-cat">{{ recipe.category.name }}</span>
                        <h2 class="h5 mt-2">
                            <a class="text-reset text-decoration-none" href="{{ path('app_recipe_show', {id: recipe.id}) }}">{{ recipe.name }}</a>
                        </h2>
                        <p class="text-muted">{{ recipe.description|slice(0, 90) }}</p>
                        <div class="d-flex gap-2">
                            <a href="{{ path('app_recipe_show', {id: recipe.id}) }}" class="btn btn-sm btn-outline-secondary">Voir</a>
                            <a href="{{ path('app_recipe_edit', {id: recipe.id}) }}" class="btn btn-sm btn-outline-secondary">Modifier</a>
                            {% include '_crud/_delete.html.twig' with {route: 'app_recipe_delete', id: recipe.id} %}
                        </div>
                    </div>
                </article>
            </div>
        {% else %}
            <div class="col-12">
                <div class="empty-state">
                    <i class="bi bi-search"></i>
                    <p class="mb-0">Aucune recette ne correspond à votre recherche.</p>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}
