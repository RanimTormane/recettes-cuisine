{% extends 'base.html.twig' %}

{% block title %}Catégories{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h1 class="h3 m-0">Catégories</h1>
        <a href="{{ path('app_category_new') }}" class="btn btn-brand"><i class="bi bi-plus-lg me-2"></i>Ajouter une catégorie</a>
    </div>

    <div class="card">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr><th style="width: 80px">#</th><th>Nom</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                {% for category in categories %}
                    <tr>
                        <td>{{ category.id }}</td>
                        <td>{{ category.name }}</td>
                        <td class="text-end">
                            <a href="{{ path('app_category_edit', {id: category.id}) }}" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil me-1"></i>Modifier</a>
                            {% include '_crud/_delete.html.twig' with {route: 'app_category_delete', id: category.id} %}
                        </td>
                    </tr>
                {% else %}
                    <tr><td colspan="3" class="text-center text-muted py-4">Aucune catégorie pour le moment.</td></tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %}
