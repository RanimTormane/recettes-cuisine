{% extends 'base.html.twig' %}

{% block title %}Recettes{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <h1 class="h3 m-0">Recettes</h1>
        <a href="{{ path('app_recipe_new') }}" class="btn btn-brand"><i class="bi bi-plus-lg me-2"></i>Ajouter une recette</a>
    </div>

    {# Recherche par nom et filtre par catégorie (envoyés dans l’URL : ?q=...&category=...) #}
    <form method="get" action="{{ path('app_recipe_index') }}" class="row g-2 mb-4">
        <div class="col-md-5">
            <input type="search" name="q" value="{{ q|default('') }}" class="form-control" placeholder="Rechercher par nom" aria-label="Rechercher par nom">
        </div>
        <div class="col-md-4">
            <select name="category" class="form-select" aria-label="Catégorie">
                <option value="">Toutes les catégories</option>
                
            </select>
        </div>
        <div class="col-md-3 d-flex gap-2">
            <button class="btn btn-brand flex-grow-1" type="submit"><i class="bi bi-search me-2"></i>Filtrer</button>
            <a href="{{ path('app_recipe_index') }}" class="btn btn-outline-secondary" title="Réinitialiser" aria-label="Réinitialiser"><i class="bi bi-x-lg"></i></a>
        </div>
    </form>

   
</div>
{% endblock %}
